#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			bindings = <
&kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6
&kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp BSPC
&mt CAPS ESC &mt LCTRL A &mt LGUI S &mt LALT D &mt LSHFT F &kp G     &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp ENTER
&kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT
&kp LCTRL  &kp LGUI   &mo 1      &kp SPACE  &kp SPACE  &mo 2                                                   &kp LEFT   &kp DOWN   &kp RIGHT
			>;
		};

		lower_layer {
			bindings = <
&kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6
&kp GRAVE  &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT   &kp BSLH   &kp SQT    &kp DEL
&trans     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12    &kp HOME   &kp END    &kp PG_UP  &kp PG_DN  &trans
&trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans                                                  &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP
			>;
		};

		raise_layer {
			bindings = <
&kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT  &kp CARET
&kp TILDE  &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR   &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC   &kp PIPE   &kp DQT    &kp DEL
&trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &sys_reset &bootloader
&trans     &trans     &trans     &trans     &trans     &trans                                                  &kp C_PREV &kp C_PP   &kp C_NEXT
			>;
		};
	};
};
